{
  "manifest_version": 3,
  "name": "简历快填 - 本地版",
  "version": "0.5.4",
  "description": "从本机简历档案填写招聘网站表单，数据不上传到第三方服务。",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "打开简历快填"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ternlight/tern_engine.js",
        "ternlight/tern_engine_bg.js",
        "ternlight/tern_engine_bg.wasm"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}

